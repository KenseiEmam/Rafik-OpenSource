generator client {
  provider        = "prisma-client"
  output          = "../server/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["file_store", "identity", "public"]
}

model buckets {
  id                 String    @id
  name               String
  public             Boolean   @default(false)
  file_size_limit    BigInt?
  allowed_mime_types String[]
  objects            objects[]

  @@schema("file_store")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model objects {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket_id String
  name      String
  metadata  Json
  buckets   buckets @relation(fields: [bucket_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bucket_id, name])
  @@schema("file_store")
}

model password_setup_tokens {
  token_hash   String   @id
  user_id      String   @db.Uuid
  workspace_id String   @db.Uuid
  created_by   String   @db.Uuid
  expires_at   DateTime @db.Timestamptz(6)

  @@index([user_id, expires_at])
  @@schema("identity")
}

model rate_limits {
  key          String   @id
  count        Int      @default(1)
  window_start DateTime @default(now()) @db.Timestamptz(6)

  @@schema("identity")
}

model identity_sessions {
  token_hash   String   @id
  user_id      String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "sessions_user")
  @@map("sessions")
  @@schema("identity")
}

model mobile_sessions {
  id                          String    @id @db.Uuid
  user_id                     String    @db.Uuid
  access_token_hash           String    @unique
  refresh_token_hash          String    @unique
  previous_refresh_token_hash String?   @unique
  access_expires_at           DateTime  @db.Timestamptz(6)
  expires_at                  DateTime  @db.Timestamptz(6)
  absolute_expires_at         DateTime  @db.Timestamptz(6)
  created_at                  DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at                DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at                  DateTime? @db.Timestamptz(6)
  device_name                 String    @default("Android device")
  users                       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, revoked_at, expires_at])
  @@schema("identity")
}

model users {
  id                                                             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                          String?                  @unique
  email_confirmed_at                                             DateTime?                @db.Timestamptz(6)
  password_hash                                                  String?
  raw_user_meta_data                                             Json                     @default("{}")
  created_at                                                     DateTime                 @default(now()) @db.Timestamptz(6)
  sessions                                                       identity_sessions[]
  mobile_sessions                                                mobile_sessions[]
  plan_deliveries                                                plan_deliveries[]
  platform_grants                                                platform_grants?
  platform_identity_state                                        platform_identity_state?
  platform_operations                                            platform_operations[]
  profiles                                                       profiles?
  program_media                                                  program_media[]
  workspace_events                                               workspace_events[]
  workspace_invitations_workspace_invitations_accepted_byTousers workspace_invitations[]  @relation("workspace_invitations_accepted_byTousers")
  workspace_invitations_workspace_invitations_created_byTousers  workspace_invitations[]  @relation("workspace_invitations_created_byTousers")
  workspace_members                                              workspace_members[]
  workspace_operations                                           workspace_operations[]
  workspaces                                                     workspaces[]
  instance_branding                                              instance_branding?

  @@schema("identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointment_slots {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  series_id    String        @db.Uuid
  coach_id     String        @db.Uuid
  starts_at    DateTime      @db.Timestamptz(6)
  ends_at      DateTime      @db.Timestamptz(6)
  local_start  DateTime      @db.Timestamp(6)
  timezone     String
  title        String
  location     String
  state        String        @default("open")
  profiles     profiles      @relation(fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments appointments?

  @@unique([series_id, starts_at])
  @@index([coach_id, starts_at], map: "slots_coach_time")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointments {
  id                String            @id @db.Uuid
  relationship_id   String            @db.Uuid
  slot_id           String            @unique(map: "slot_one_booking", where: raw("(state = 'booked'::text)")) @db.Uuid
  starts_at         DateTime          @db.Timestamptz(6)
  ends_at           DateTime          @db.Timestamptz(6)
  title             String
  location          String
  timezone          String
  state             String            @default("booked")
  note              String            @default("")
  revision          Int               @default(1)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  coach_clients     coach_clients     @relation(fields: [relationship_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointment_slots appointment_slots @relation(fields: [slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([relationship_id, starts_at], map: "appointments_relationship_time")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assignments {
  id                                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  relationship_id                          String                @unique(map: "one_active_assignment", where: raw("(state = 'active'::text)")) @db.Uuid
  coach_id                                 String                @db.Uuid
  client_id                                String                @db.Uuid
  version_id                               String                @db.Uuid
  start_date                               DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  state                                    String                @default("active")
  created_at                               DateTime              @default(now()) @db.Timestamptz(6)
  schedule_mode                            String                @default("flexible")
  end_date                                 DateTime?             @db.Date
  revision                                 Int                   @default(1)
  profiles_assignments_client_idToprofiles profiles              @relation("assignments_client_idToprofiles", fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_assignments_coach_idToprofiles  profiles              @relation("assignments_coach_idToprofiles", fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coach_clients                            coach_clients         @relation(fields: [relationship_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan_versions                            plan_versions         @relation(fields: [version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitations                              invitations[]
  schedule_exceptions                      schedule_exceptions[]
  sessions                                 public_sessions[]

  @@index([client_id, state], map: "assignments_client")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model business_accounts {
  id                String            @id @db.Uuid
  owner_id          String?           @unique @db.Uuid
  team_id           String?           @unique @db.Uuid
  state             String            @default("trial")
  access_until      DateTime          @default(dbgenerated("(now() + '14 days'::interval)")) @db.Timestamptz(6)
  staff_limit       Int               @default(10)
  client_limit      Int               @default(50)
  provider_sequence BigInt            @default(0)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  profiles          profiles?         @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teams             teams?            @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  business_events   business_events[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model business_events {
  id                String            @id @db.Uuid
  account_id        String            @db.Uuid
  sequence          BigInt
  payload           Json
  applied           Boolean
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  business_accounts business_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([account_id, sequence])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model client_context {
  id            String        @id @db.Uuid
  goals         String        @default("")
  constraints   String        @default("")
  notes         String        @default("")
  revision      Int           @default(1)
  updated_at    DateTime      @default(now()) @db.Timestamptz(6)
  coach_clients coach_clients @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model coach_clients {
  id                                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_id                                   String               @db.Uuid
  client_id                                  String               @db.Uuid
  state                                      String               @default("active")
  created_at                                 DateTime             @default(now()) @db.Timestamptz(6)
  appointments                               appointments[]
  assignments                                assignments?
  client_context                             client_context?
  profiles_coach_clients_client_idToprofiles profiles             @relation("coach_clients_client_idToprofiles", fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_coach_clients_coach_idToprofiles  profiles             @relation("coach_clients_coach_idToprofiles", fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coaching_requests                          coaching_requests[]
  conversation_reads                         conversation_reads[]
  meal_entries                               meal_entries[]
  measurements                               measurements[]
  messages                                   messages[]
  nutrition_guidance                         nutrition_guidance[]
  resource_shares                            resource_shares[]
  team_clients                               team_clients?

  @@unique([coach_id, client_id])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model coaching_forms {
  id                String              @id @db.Uuid
  coach_id          String              @db.Uuid
  title             String
  kind              String
  fields            Json
  revision          Int                 @default(1)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  profiles          profiles            @relation(fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coaching_requests coaching_requests[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model coaching_requests {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  series_id       String          @db.Uuid
  relationship_id String          @db.Uuid
  form_id         String?         @db.Uuid
  form_revision   Int
  title           String
  kind            String
  fields          Json
  due_date        DateTime        @db.Date
  answers         Json            @default("{}")
  revision        Int             @default(1)
  submitted_at    DateTime?       @db.Timestamptz(6)
  reviewed_at     DateTime?       @db.Timestamptz(6)
