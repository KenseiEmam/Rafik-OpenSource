    "vue-router": "^4.4.5",
    "vue-search-select": "^3.2.0",
    "vue-select-next": "^0.1.6",
    "vue-sweetalert2": "^5.0.11",
    "vue3-circle-progress": "^1.0.7",
    "vue3-cropper": "^0.4.0",
    "vue3-tel-input": "^1.0.4",
    "vuedraggable": "^4.1.0"
