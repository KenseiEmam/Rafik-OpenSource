# Copy to infrastructure/.env.selfhost on the Unix server and fill every value.
# Generate both database passwords with: openssl rand -hex 32
RAFIK_INSTANCE_ID=university
APP_DOMAIN=rafik.example.edu
ACME_EMAIL=it@example.edu
POSTGRES_PASSWORD=replace_with_64_hex_characters
RAFIK_API_PASSWORD=replace_with_a_different_64_hex_value
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=55332
