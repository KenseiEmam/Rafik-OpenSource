  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  profiles        profiles       @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saved_foods     saved_foods?   @relation(fields: [food_id], references: [id], onUpdate: NoAction)
  coach_clients   coach_clients? @relation(fields: [relationship_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id, logged_on], map: "meals_owner_date")
