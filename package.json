{
  "name": "rafik-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/isolated-browser.mjs",
    "format": "prettier --write src tests build *.ts",
    "format:check": "prettier --check src tests build *.ts",
    "test:teams:layout": "node --experimental-strip-types scripts/verify-team-layout.ts && node --experimental-strip-types scripts/verify-team-layout.ts --webkit",
    "test:quality:layout": "node scripts/verify-product-quality.mjs",
    "test:product:layout": "node --experimental-strip-types scripts/audit-product.ts",
    "test:build": "node --experimental-strip-types scripts/check-shell-build.mjs",
    "test:e2e:running": "playwright test",
    "test:operations:layout": "node --experimental-strip-types scripts/audit-operations.ts",
    "test:cohesion:layout": "node --experimental-strip-types scripts/audit-cohesion.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@phosphor-icons/vue": "2.2.1",
    "idb": "8.0.3",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
