      if(this.searchIndex< this.customers.length){
        this.searchIndex ++
      }
      else{
        this.searchIndex = 0
      }
    },
    loadTemplate(template){
      document.getElementById('closeValib').click()
      if ('is_template' in template){
        delete template.is_template
      }
      this.type = template
      this.tagList = template.tags_details
      this.customerList = template.notifications_details
