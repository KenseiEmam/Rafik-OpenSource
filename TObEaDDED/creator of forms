          this.customerList.splice(id,1)
          this.type.notifications.splice(id,1)
        },
        deleteTag(id){
          this.tagList.splice(id,1)
          this.type.tags.splice(id,1)
        },
        sort_by_name() {
				return function (elem1, elem2) {
				if (elem1.name < elem2.name) {
					return -1;
				} else if (elem1.name > elem2.name) {
					return 1;
				} else {
					return 0;
				}
				}},
        deleteOption(field,id){
          let sect = field.options.find(o => o.opIndex === id)
          field.options.splice( field.options.indexOf(sect),1)
        },
        cancel(){
          Swal.fire({
							icon: "warning",
							title: "Hold",
							text: "Discard changes and cancel addition?",
							showConfirmButton: true,
