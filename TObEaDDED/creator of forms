    addNotification(){
        let sendDays =  this.notifDays
        if(sendDays > 0){

          if(this.notifType === 'months'){
            sendDays = sendDays * 30
          }
          else if(this.notifType === 'weeks'){
            sendDays = sendDays * 7
          }
          this.type.days_before_expiry.push(sendDays)
          this.resetFields()
        }

      },
      resetFields(){
        this.notifType = 'days'
        this.notifDays = 0
      },
      deleteNotif(id){
      this.type.days_before_expiry.splice(this.type.days_before_expiry.indexOf(id),1) 
      },
      alertString(value){
          let reply= ''
          let days = 0
          let months = 0 
          let weeks = 0
          if(Math.floor(value / 30) > 0){
            months = Math.floor(value/30)
            if(months === 1){
              reply += months+' month '
            }
            else{

              reply += months+' months '
            }
          }
          if(Math.floor((value - (months*30))/7) > 0){
            weeks = Math.floor((value - (months*30))/7)
            if(weeks === 1){
              reply += weeks+' week '
            }
            else{

              reply += weeks+' weeks '
            }
          }
          if(months > 0 || weeks> 0 ){
            reply += 'and '
          }
          days = value -(months*30) - (weeks*7)
          if(days === 1){
            reply += days+' day'
            }
            else{

              reply += days+' days'
            }
            
          return reply
        },
    debCheck: _.debounce(function(){
        if(this.search === ""|| this.search === null)
        {
            this.searchcustomers({input:null, number:15})
        }
        else{
            
            this.searchcustomers({input:this.search, number:100})
        }
        }, 700),
    toggleClass(string){
        
        this.active=string
    },
