{
  "name": "@rafik/backend",
  "version": "1.0.0-beta.1",
  "private": true,
  "scarfSettings": {
    "enabled": false
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node scripts/prisma/local.mjs start",
    "stop": "node scripts/prisma/local.mjs stop",
    "test": "node scripts/prisma/local.mjs test",
    "types": "tsx scripts/prisma/types.ts",
    "web-env": "node scripts/prisma/local.mjs web-env",
    "content": "node scripts/content.mjs",
    "content:check": "node scripts/content.mjs --check",
    "test:fresh": "node scripts/prisma/fresh.mjs",
    "test:services": "node scripts/verify-services.mjs",
    "support:local": "node scripts/support-local.mjs",
    "test:teams": "node scripts/verify-teams.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:release": "node --test scripts/release-guard.test.mjs",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../../infrastructure/compose.yaml --profile local up -d --wait",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "seed:local": "node scripts/prisma/local.mjs seed",
    "test:api": "tsx --test tests/api.test.ts",
    "test:api-docs": "tsx --test tests/api-docs.test.ts",
    "test:organizations": "tsx --test tests/workspaces.test.ts",
    "test:programming": "tsx --test tests/programming.test.ts tests/program-media.test.ts",
    "test:organization-services": "tsx --test tests/organization-services.test.ts",
    "test:communication": "tsx --test tests/communication.test.ts tests/notifications.test.ts",
    "notifications:local": "tsx scripts/dispatch-notifications.ts",
    "test:operations": "tsx --test tests/platform.test.ts tests/scale.test.ts tests/maintenance.test.ts tests/local-boundary.test.ts",
    "recovery:local": "node scripts/prisma/recovery.mjs",
    "files:maintenance": "node scripts/prisma/cleanup-private.mjs",
    "test:catalog": "tsx --test tests/public-catalog.test.ts tests/exercise-video.test.ts",
    "content:media": "node scripts/content/exercise-media.mjs",
    "content:exercise-dataset": "node scripts/content/exercise-dataset.mjs",
    "content:exercise-dataset:check": "node scripts/content/exercise-dataset.mjs --check",
    "content:wger-exercises": "node scripts/content/wger-exercises.mjs --from-review",
    "content:wger-exercises:check": "node scripts/content/wger-exercises.mjs --check",
    "content:videos": "node scripts/content/exercise-videos.mjs",
    "test:organization-nutrition": "tsx --test tests/organization-nutrition.test.ts",
    "test:organization-assets": "tsx --test tests/organization-assets.test.ts",
    "test:organization-tasks": "tsx --test tests/organization-tasks.test.ts",
    "test:organization-feedback": "tsx --test tests/organization-feedback.test.ts",
    "test:organization-injuries": "tsx --test tests/organization-injuries.test.ts",
    "test:injury-retention-scheduler": "tsx --test tests/organization-injury-retention-scheduler.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rafik/shared": "1.0.0-beta.1",
    "pg": "8.16.3",
    "prisma": "7.10.1",
    "swagger-ui-dist": "5.33.3",
    "tsx": "4.20.6"
  }
}
