    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/vue3": "^6.1.17",
    "@supabase/supabase-js": "^2.48.0",
    "@types/vue-cropperjs": "^4.1.6",
    "@vuepic/vue-datepicker": "^11.0.2",
    "cropperjs": "^2.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "emailjs": "^4.0.3",
    "esbuild": "^0.25.2",
    "flowbite": "^3.0.0",
    "lodash": "^4.17.21",
    "pinia": "^2.2.6",
