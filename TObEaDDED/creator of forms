      if (!this.type.notifications.includes(customer.id)){

        this.customerList.push(customer)
        this.type.notifications.push(customer.id)
      }
      document.getElementById('search').blur()
    },
    suggestTag(tag){
      if (!this.type.tags.includes(tag.id)){

        this.tagList.push(tag)
        this.type.tags.push(tag.id)
      }
      document.getElementById('searchest').blur()
    },
    searchTagIncrement(){
      if(this.searchTagIndex< this.tags.length){
        this.searchTagIndex ++
      }
      else{
        this.searchTagIndex = 0
      }
    },
    searchTagDecrement(){
      if(this.searchTagIndex> 0 ){
        this.searchTagIndex --
      }
      else{
        this.searchTagIndex = this.tags.length
      }
