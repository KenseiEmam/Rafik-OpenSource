  notification_events                                  notification_events[]
  notification_intercepts                              notification_intercepts[]
  notification_preferences                             notification_preferences?
  plan_versions                                        plan_versions[]
  plans                                                plans[]
  users                                                users                     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resources                                            resources[]
  saved_foods                                          saved_foods[]
  sessions_sessions_client_idToprofiles                public_sessions[]         @relation("sessions_client_idToprofiles")
  sessions_sessions_coach_idToprofiles                 public_sessions[]         @relation("sessions_coach_idToprofiles")
  support_cases                                        support_cases[]
