    import FileInput from '../components/FileInput.vue';
    import DocumentServices from "../services/DocumentServices";
    import SettingsServices from '../services/SettingsServices';
import Datepicker from '@vuepic/vue-datepicker';
    import Swal from 'sweetalert2';
    import _ from 'lodash';
    import { mapState, mapActions, mapGetters } from "vuex";
    import UsersServices from "../services/UsersServices";
    import VuePdfApp from "vue3-pdf-app";
    import  {PhoneInput}  from '@lbgm/phone-number-input';
import '@lbgm/phone-number-input/style';
// import this to use default icons for buttons
import "vue3-pdf-app/dist/icons/main.css";
import ClipLoader from 'vue-spinner/src/ClipLoader.vue'
      export default{
        components: {
                FileInput,
                Datepicker,
                VuePdfApp,
                ClipLoader,
                PhoneInput
            },
          data(){
            return {
              submittig:false,
              access:true,
              countries:[],
                pdfLink:'',
                activeTab:'General',
                title:'',
                tags:[],
              document:{
                name:'',
                tags:[],
                expiry:new Date(),
                related_to:null,
                document_type:null,
                confidentiality:null,
                fields:[
                

                ],
                hide_from:[],
                hidden_groups:[],
                shared_with:{
                  customers:[],
                  shared_by:null
                }
              },
              userGroups:[],
              shared_with_details:[],
              file:null,
              docType:null,
              currentFile:null,
              expireN:false,
              searcher:null,
              searchTagIndex:0,
              hidden_group:null,
            userList:[],
            search:null,
            sharesearch:null,
            customerName:null,
            searchValue:null,
            groupList:[],
            searchIndex:0,
            groups:[],
            levels:[1,2,3,4,5],
            selected:null,
            active:'users',
            tagList:[],
            types:[
                

            ]
          }
        },
        props:{
          id:String
        },
        methods:{
          callback (data) {
        console.debug(data)
      },
      checkValid(event, field){
    
     if(event.isValid){
      
       field.value = event.number
     }
     else{
      field.value = null
     }
  },
      sharedebCheck: _.debounce(function(){
        if(this.sharesearch === ""|| this.sharesearch === null)
        {
            this.searchcustomers({input:null, number:15})
        }
        else{
            
            this.searchcustomers({input:this.sharesearch, number:100})
        }
        }, 700),
      debCheck: _.debounce(function(){
        if(this.search === ""|| this.search === null)
        {
            this.searchcustomers({input:null, number:15})
        }
        else{
            
            this.searchcustomers({input:this.search, number:100})
        }
        }, 700),
        searchIndexIncrement(){
          if(this.searchIndex< this.customerRange.length){
            this.searchIndex ++
          }
          else{
            this.searchIndex = 0
          }
        },
      relatedSearch: _.debounce(function(){
            this.customerName = this.searchValue
        if(this.searchValue === ""|| this.searchValue === null)
        {
            this.searchcustomers({input:null, number:15})
        }
        else{
            
            this.searchcustomers({input:this.searchValue, number:100})
        }
        }, 700),
        toggleClass(string){
        
        this.active=string
    },
    suggestcustomer(id,name, customer){
                this.selected= customer
                this.customerName = name
                this.document.related_to = id
            },
     reSearch(){
                this.selected=null
                this.searchValue = null
                this.customerName = null
                this.document.related_to = null
            },
    searchIndexDecrement(){
      if(this.searchIndex> 0 ){
        this.searchIndex --
      }
      else{
        this.searchIndex = this.customerRange.length
      }
    },
    
    suggestTag(tag){
      if (!this.document.tags.includes(tag.id)){

        this.tagList.push(tag)
        this.document.tags.push(tag.id)
      }
      document.getElementById('searchest').blur()
    },
    searchTagIncrement(){
      if(this.searchTagIndex< this.tags.length){
        this.searchTagIndex ++
      }
      else{
        this.searchTagIndex = 0
      }
    },
    searchTagDecrement(){
      if(this.searchTagIndex> 0 ){
        this.searchTagIndex --
      }
      else{
        this.searchTagIndex = this.tags.length
      }
    },
    tagCheck: _.debounce(function(){
        if(this.searcher === ""|| this.searcher === null)
        {
            this.tags = []
        }
        else{
            
            DocumentServices.searchTags(this.searcher).then((response)=>{
              this.tags = response.data
            })
        }
        }, 700),
    handleDate(event, field){
      field = new Date(event).toLocaleDateString('en-GB',{year: 'numeric', month: 'numeric', day: 'numeric'}).split('/').reverse().join('-')
    },

      addgroup(){
       
        this.groupList.push(this.hidden_group)
        this.document.hidden_groups.push(this.hidden_group.id)
        this.hidden_group = null
      },
      adduser(customer){
        if(!this.document.hide_from.includes(customer.id)){

          this.userList.push(customer)
          this.document.hide_from.push(customer.id)
        }
        document.getElementById('search').blur()
      },
      addshare(customer){
        if(!this.document.shared_with.customers.includes(customer.id)){

          this.shared_with_details.push(customer)
          this.document.shared_with.customers.push(customer.id)
        }
        document.getElementById('search').blur()
      },
      groupRemove(index){
        this.groupList.splice(index,1)
        this.document.hidden_groups.splice(index,1)
      },
      userRemove(index){
        this.userList.splice(index,1)
        this.document.hide_from.splice(index,1)
      },
      shareRemove(index){
        this.shared_with_details.splice(index,1)
        this.document.shared_with.customers.splice(index,1)
      },
      deleteTag(id){
          this.tagList.splice(id,1)
          this.document.tags.splice(id,1)
        },
      addDoc(){
        this.submittig = true
        if(this.expireN){
          delete this.document.expiry
        }
        else{
          this.document.expiry = new Date(this.document.expiry).toLocaleDateString('en-GB',{year: 'numeric', month: 'numeric', day: 'numeric'}).split('/').reverse().join('-')
        }
        const getFormData = object => Object.entries(object).reduce((fd, [ key, val ]) => {
        if (Array.isArray(val) && key !== 'fields') {
        val.forEach(v => fd.append(key, v))
        } else {
        fd.append(key, val)
        }
        return fd
        }, new FormData())
        console.log(this.document)
        DocumentServices.postFile(getFormData({file:this.file})).then((response)=>{
          this.document.document = response.data.id
          
            DocumentServices.postDocument(this.document.document_type,this.document).then((respoe)=>{
              if(this.document.shared_with.customers.length > 0){

                          DocumentServices.shareDocument(respoe.data.id, this.document.shared_with.customers).then(()=>{
                            Swal.fire({
                                  icon: "success",
                                  title: "Success!",
showConfirmButton:false,
timerProgressBar:true,
timer:1500,
                                  text: "The document has been added and shared! ",
                                  toast: true,
                                  position: 'top',
                                  showConfirmButton: false,
                                  timerProgressBar: true,
                                  timer: 3000,
                                })
                          }).catch((erro)=>{
                            Swal.fire({
                                  icon: "warning",
                                  title: "Document uploaded but failed to share",
                                  text: Object.keys(erro.response.data).at(0) + " : " + erro.response.data[Object.keys(erro.response.data).at(0)].at(0),
                                  toast: true,
                                  position: 'top',
                                  showConfirmButton: false,
                                  timerProgressBar: true,
                                  timer: 3000,
                                })
                          })
                          }
                          else{
                          Swal.fire({
                                  icon: "success",
                                  title: "Success!",
showConfirmButton:false,
timerProgressBar:true,
timer:1500,
                                  text: "The document has been added! ",
                                  toast: true,
                                  position: 'top',
                                  showConfirmButton: false,
                                  timerProgressBar: true,
                                  timer: 3000,
                                })
                          }

                    this.$router.push({name:'drawer', params:{id:this.id}})
                }).catch((error)=>{
                  DocumentServices.deleteFile(response.data.id)
                  let message = Object.keys(error.response.data).at(0) + " : " + error.response.data[Object.keys(error.response.data).at(0)].at(0)
                    if(Object.keys(error.response.data).at(0) === 'fields'){
                      message = error.response.data[Object.keys(error.response.data).at(0)].at(0)
                    }
                  Swal.fire({
                      icon: "error",
                      title: "Error!",
                      text: message,
                      toast: true,
                      position: 'top',
                      showConfirmButton: false,
                      timerProgressBar: true,
                      timer: 3000,
                    })
                    this.submittig = false
                })
      }).catch((error)=>{
                  
                  let message = Object.keys(error.response.data).at(0) + " : " + error.response.data[Object.keys(error.response.data).at(0)].at(0)
                    if(Object.keys(error.response.data).at(0) === 'fields'){
                      message = error.response.data[Object.keys(error.response.data).at(0)].at(0)
                    }
                  Swal.fire({
                      icon: "error",
                      title: "Error!",
                      text: message,
                      toast: true,
                      position: 'top',
                      showConfirmButton: false,
                      timerProgressBar: true,
                      timer: 3000,
                    })
                    this.submittig = false
                })
      },
      previewFilesDrag(event){
        this.docType = event.dataTransfer.files[0].type
          this.pdfLink = URL.createObjectURL(event.dataTransfer.files[0])
          this.file = event.dataTransfer.files[0]
          if(this.docType === 'image/jpeg' || this.docType === 'image/png' || this.docType === 'image/jpg'){
       var reader = new FileReader();
        reader.onload = function()
        {
          var output = document.getElementById('output-image');


          output.setAttribute("src",reader.result)
        
        
          document.getElementById('output-image').load();
        }}
        reader.readAsDataURL(event.dataTransfer.files[0]);
      },
      previewFiles(event) {
          this.docType = event.target.files[0].type
          this.pdfLink = URL.createObjectURL(event.target.files[0])
          this.file = event.target.files[0]
          if(this.docType === 'image/jpeg' || this.docType === 'image/png' || this.docType === 'image/jpg'){
       var reader = new FileReader();
        reader.onload = function()
        {
          var output = document.getElementById('output-image');

            output.setAttribute("src",URL.createObjectURL(event.target.files[0]))
        
          document.getElementById('output-image').load();
        }
    }
        reader.readAsDataURL(event.target.files[0]);
       },
       removeFile(){
        this.docType= null
        this.file= null
       },
       preventDef(e){
        e.preventDefault();
       },
       dragReact(event){

        event.preventDefault();
					this.file= event.dataTransfer.files[0] ;
				console.log(event.dataTransfer.files[0])
				
				this.previewFilesDrag(event)
       },
      populateFields(){
        let typ = this.types.find(t=> t.id === this.document.document_type)
        if(typ){

            typ.fields.map(t => ({...t,value:null}))
            this.document.fields = typ.fields
            this.tagList = typ.tags_details
            this.document.tags = typ.tags
        }
        else{
            this.document.fields = []
        }
      },

          cancel(){
            Swal.fire({
							icon: "warning",
							title: "Hold",
							text: "Discard changes and return to drawer?",
							showConfirmButton: true,
                            showDenyButton: true,
                            confirmButtonColor: '#0E2D5B',
                            denyButtonColor: '#990c53',
						}).then((result)=>{
              if(result.value){
                this.$router.push({name:'drawer', params:{id:this.id}})
              }
            })
          },
          ...mapActions({
			getcustomers: 'Users/getAllCustomers',
            getstaff: 'Users/getStaff',
            getcustomer: 'Users/getCustomer',
            searchcustomers: 'Users/searchCustomers',
            
        }),
        scopeCheck(scope){
				let user= JSON.parse(localStorage.getItem('userdetail'))

				if(user.is_company){
				return true;
				}else{
				return localStorage.getItem('scopes').includes(scope)}
			}	,
      },
      computed:{
        ...mapState({
            customers: state => state.Users.customers,
            customer: state=> state.Users.customer,
        }),
        ...mapGetters('Users', [
        'customerOnly',
        'staffOnly',
        "ELE",
        "OPE"
      ]),
        customerRange(){
        if(this.customers)
        {return this.customers.slice(0,7)}
        else{
            return []
        }
      },
      tagRange(){
        if(this.tags)
        {return this.tags}
        else{
            return []
        }
      }
      
      },
        created(){
          this.getstaff()
          SettingsServices.getCountries().then((response)=>{
        this.countries = response.data
      })
      DocumentServices.getTypes(this.id).then((response)=>{
      this.types = response.data
    })
      DocumentServices.getShelf(this.id).then((response)=>{
      this.title = response.data.section.name
    }).catch(()=>{
      this.access = false
    })
    SettingsServices.getUserGroups().then((response)=>{
        this.userGroups = response.data
      })
        }
      }



      


      </script>